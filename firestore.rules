rules_version = '2';

// Players can only do three things to their own coins: claim 100 once a day,
// pay the stake of a bet they place, or rename themselves. Results, payouts
// and match odds are written only by the sync job (scripts/sync.mjs), which
// uses the Admin SDK and is not bound by these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Day number for the daily claim. DAY_OFFSET_MS must match
    // DAY_OFFSET_HOURS in public/config.js (4 hours = 14400000).
    function today() {
      let DAY_OFFSET_MS = 14400000;
      return math.floor((request.time.toMillis() + DAY_OFFSET_MS) / 86400000);
    }

    function validName(n) { return n is string && n.size() >= 1 && n.size() <= 20; }
    function playerPath(uid) { return /databases/$(database)/documents/players/$(uid); }
    function betPath(id) { return /databases/$(database)/documents/bets/$(id); }

    match /matches/{matchId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /live/{matchId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /players/{uid} {
      allow read: if signedIn();

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'coins', 'lastClaimDay', 'won', 'lost', 'joined'])
        && validName(request.resource.data.name)
        && request.resource.data.coins == 0
        && request.resource.data.lastClaimDay == 0
        && request.resource.data.won == 0
        && request.resource.data.lost == 0
        && request.resource.data.joined == request.time;

      allow update: if signedIn() && request.auth.uid == uid
        && (isClaim() || isBet() || isRename());

      allow delete: if false;

      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

      function isClaim() {
        return changed().hasOnly(['coins', 'lastClaimDay'])
          && resource.data.lastClaimDay < today()
          && request.resource.data.lastClaimDay == today()
          && request.resource.data.coins == resource.data.coins + 100;
      }

      // The stake leaves the wallet only together with a new bet document
      // written in the same batch, and the player doc points at that bet.
      function isBet() {
        return changed().hasOnly(['coins', 'lastBet'])
          && changed().hasAll(['coins', 'lastBet'])
          && paysFor(request.resource.data.lastBet);
      }

      function paysFor(betId) {
        let bet = getAfter(betPath(betId)).data;
        return betId is string
          && !exists(betPath(betId))
          && existsAfter(betPath(betId))
          && bet.uid == uid
          && request.resource.data.coins == resource.data.coins - bet.stake
          && request.resource.data.coins >= 0;
      }

      function isRename() {
        return changed().hasOnly(['name']) && validName(request.resource.data.name);
      }
    }

    match /bets/{betId} {
      allow read: if signedIn();

      allow create: if signedIn() && isValidBet(request.resource.data);
      allow update, delete: if false;

      // A bet has 1 to 6 legs (a multi-bet when more than one). Rules have no
      // loops, so each possible leg index is checked explicitly. (More legs
      // would hit the 1000-expression limit for one request.)
      function isValidBet(b) {
        let me = playerPath(request.auth.uid);
        return b.keys().hasOnly(['uid', 'name', 'legs', 'mids', 'stake', 'odds', 'status', 'placed', 'live'])
          && b.uid == request.auth.uid
          && b.status == 'open'
          && b.placed == request.time
          && b.stake is int && b.stake >= 1
          && b.name is string && b.name.size() <= 20
          && b.odds is number && b.odds >= 1
          && b.legs is list && b.legs.size() >= 1 && b.legs.size() <= 6
          && b.mids is list && b.mids.size() == b.legs.size()
          && (b.get('live', false) == true
            ? b.legs.size() == 1 && liveLegOk(b.legs[0], b.mids[0])
            : leg(b, 0) && leg(b, 1) && leg(b, 2) && leg(b, 3) && leg(b, 4) && leg(b, 5))
          // the stake is paid for in the same batch
          && getAfter(me).data.lastBet == betId
          && getAfter(me).data.coins == get(me).data.coins - b.stake;
      }

      function leg(b, i) {
        return b.legs.size() <= i || legOk(b.legs[i], b.mids[i]);
      }

      // The match is still open and the price is exactly the published one.
      // (Payouts are recomputed from the legs by the sync job.)
      function legOk(l, mid) {
        let m = get(/databases/$(database)/documents/matches/$(l.m)).data;
        return l is map
          && l.keys().hasOnly(['m', 'k', 'o', 'label', 'fx'])
          && l.m is string && l.m == mid
          && l.k is string
          && l.label is string && l.label.size() <= 120
          && l.fx is string && l.fx.size() <= 120
          && m.status == 'scheduled'
          && m.ko > request.time
          && l.o == m.p[l.k]; // an unknown key is an error, so denied
      }

      // Live bets are singles at the live price, while betting is open,
      // from live data at most 60s old, recording the score and clock they
      // were placed at (settlement uses these to catch unseen goals).
      function liveLegOk(l, mid) {
        let lv = get(/databases/$(database)/documents/live/$(l.m)).data;
        return l is map
          && l.keys().hasOnly(['m', 'k', 'o', 'label', 'fx', 'sc', 't'])
          && l.m is string && l.m == mid
          && l.k is string && l.k.matches('lv:.*')
          && l.label is string && l.label.size() <= 120
          && l.fx is string && l.fx.size() <= 120
          && lv.done == false
          && lv.susp == false
          && request.time < lv.at + duration.value(60, 's')
          && l.sc == [lv.sh, lv.sa]
          && l.t == lv.clk
          && l.o == lv.p[l.k];
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
